# =========================
# Database Configuration
# =========================

# PostgreSQL (Write Database)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=auth_db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# MongoDB (Read Database for Query Service)
MONGODB_CONNECTION_STRING=mongodb://mongodb:27017
MONGODB_DATABASE=auth_query

# =========================
# Message Broker
# =========================

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUALHOST=/

# =========================
# JWT Configuration
# =========================

# IMPORTANT: Change this to a strong random key in production!
# Generate using: openssl rand -base64 64
JWT_KEY=THIS_IS_A_MUCH_LONGER_AND_MORE_SECURE_SUPER_SECRET_KEY_123456789
JWT_ISSUER=Soundmates.Auth
JWT_AUDIENCE=Soundmates.Users
JWT_EXPIRES_IN_HOURS=48

# =========================
# Google OAuth (Optional)
# =========================

# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# =========================
# Email Configuration (Optional)
# =========================

# SMTP Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM=your-email@gmail.com
EMAIL_USERNAME=your-email@gmail.com

# For Gmail: Generate App Password at https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-gmail-app-password-here

# =========================
# Frontend Configuration
# =========================

FRONTEND_URL=http://localhost:3000
