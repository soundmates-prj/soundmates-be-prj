# Shared runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# Shared infrastructure
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Service databases
AUTH_DB_NAME=auth_db
AI_DB_NAME=ai_db
LIVE_SESSION_DB_NAME=live_session_db
ACCOUNT_CONTENT_DB_NAME=account_content_db

# Mongo read side
MONGODB_CONNECTION_STRING=mongodb://mongodb:27017
MONGODB_DATABASE=auth_query

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUALHOST=/

# JWT
JWT_SECRET=replace-with-a-strong-secret
JWT_ISSUER=soundmates
JWT_AUDIENCE=soundmates
JWT_EXPIRES_IN_HOURS=48

# Gemini / LLM
GEMINI_PROVIDER=Gemini
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=replace-with-llm-api-key

# TTS
TTS_PROVIDER=vienetts
TTS_BASE_URL=http://host.docker.internal:23334
TTS_API_KEY=
TTS_SYNTHESIZE_PATH=/stream
TTS_AUDIO_FORMAT=wav
TTS_TIMEOUT_SECONDS=60
TTS_DEMO_MODE=false

# Auth and integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Account content payment and encryption
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8004/api/v1/payments/vnpay/callback
AES_KEY=
AES_IV=

# Service URLs
FRONTEND_URL=http://localhost:3000
AI_PUBLIC_BASE_URL=http://localhost:8067
AZURACAST_BASE_URL=http://host.docker.internal:5000
AZURACAST_API_KEY=
