          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/v1/command/user/{everything}",
      "UpstreamHttpMethod": [ "POST", "PUT", "DELETE", "OPTIONS" ]
    },

    // === USER QUERIES ===
    {
