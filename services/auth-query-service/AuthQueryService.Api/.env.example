# ================================================
# Auth Query Service - Environment Configuration
# ================================================
# Copy this file to .env and update the values

# ================================================
# ASP.NET Core Configuration
# ================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# ================================================
# PostgreSQL Configuration (Write Database)
# ================================================
# Used for reading user data from write database (for initial sync)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=auth_db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# ================================================
# MongoDB Configuration (Read Database)
# ================================================
# Connection string format: mongodb://username:password@host:port
# For local development without auth:
#   MONGODB_CONNECTION_STRING=mongodb://localhost:27017
# With authentication:
#   MONGODB_CONNECTION_STRING=mongodb://admin:password@localhost:27017

MONGODB_CONNECTION_STRING=mongodb://admin:123@localhost:27017/?authSource=admin
MONGODB_DATABASE=auth_query

Mongo__ConnectionString=mongodb://admin:123@localhost:27017/?authSource=admin
Mongo__Database=auth_query

# Alternative MongoDB credentials (if using separate app user)
# MONGODB_USERNAME=soundmates_app
# MONGODB_PASSWORD=app_password

# ================================================
# RabbitMQ Configuration (Message Broker)
# ================================================
# Receives events from Auth Service to sync data
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUALHOST=/

# ================================================
# JWT Configuration
# ================================================
# Must match Auth Service JWT configuration
JWT_KEY=THIS_IS_A_MUCH_LONGER_AND_MORE_SECURE_SUPER_SECRET_KEY_123456789
JWT_ISSUER=Soundmates.Auth
JWT_AUDIENCE=Soundmates.Users
JWT_EXPIRES_IN_HOURS=48

# ================================================
# Logging Configuration
# ================================================
# Logging levels: Trace, Debug, Information, Warning, Error, Critical
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT_ASPNETCORE=Warning
