# ================================================
# Auth Query Service - Environment Configuration
# ================================================
# Copy this file to .env and update the values

# ================================================
# ASP.NET Core Configuration
# ================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# ================================================
# PostgreSQL Configuration (Write Database)
# ================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=auth_db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# ================================================
# MongoDB Configuration (Read Database)
# ================================================
MONGODB_CONNECTION_STRING=mongodb://admin:123@localhost:27017/?authSource=admin
MONGODB_DATABASE=auth_query

# ================================================
# RabbitMQ Configuration (Message Broker)
# ================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUALHOST=/

# ================================================
# JWT Configuration
# ================================================
# Must match Auth Service JWT configuration exactly
JWT_KEY=YOUR_JWT_SECRET_KEY_HERE
JWT_ISSUER=Soundmates.Auth
JWT_AUDIENCE=Soundmates.Users
JWT_EXPIRES_IN_HOURS=48

# ================================================
# Spotify API (Client Credentials — search proxy)
# ================================================
# Register at https://developer.spotify.com/dashboard
# Required for GET /api/v1/spotify/search and related endpoints.
# NOTE: Spotify Developer Mode apps are limited to limit ≤ 10 per search.
#       Request a quota extension in the Spotify Dashboard to raise this to 50.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ================================================
# Logging Configuration
# ================================================
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT_ASPNETCORE=Warning
