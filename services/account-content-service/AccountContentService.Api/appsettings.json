{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=${DB_PORT};Database=${ACCOUNT_CONTENT_DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};Ssl Mode=Disable;Trust Server Certificate=True;"
  },
  "RabbitMq": {
    "HostName": "${RABBITMQ_HOST}",
    "Port": "${RABBITMQ_PORT}",
    "UserName": "${RABBITMQ_USERNAME}",
    "Password": "${RABBITMQ_PASSWORD}",
    "VirtualHost": "${RABBITMQ_VIRTUALHOST}",
    "ConfigExchange": "config.exchange",
    "GeminiRoutingKey": "config.gemini.updated"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpiresInHours": "${JWT_EXPIRES_IN_HOURS}"
  },
  "GoogleOAuth": {
    "ClientId": "${GOOGLE_CLIENT_ID}",
    "ClientSecret": "${GOOGLE_CLIENT_SECRET}"
  },
  "EmailSettings": {
    "Host": "${EMAIL_HOST}",
    "Port": "${EMAIL_PORT}",
    "From": "${EMAIL_FROM}",
    "Username": "${EMAIL_USERNAME}",
    "Password": "${EMAIL_PASSWORD}"
  },
  "AppSettings": {
    "FrontendUrl": "${FRONTEND_URL}"
  },
  "VNPay": {
    "TmnCode": "${VNPAY_TMN_CODE}",
    "HashSecret": "${VNPAY_HASH_SECRET}",
    "BaseUrl": "${VNPAY_BASE_URL}",
    "ReturnUrl": "${VNPAY_RETURN_URL}"
  },

  "AESEncryption": {
    "Key": "${AES_KEY}",
    "IV": "${AES_IV}"
  },

  "PayOS": {
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": ""
  },
  "ApiGateway": {
    "BaseUrl": "${GATEWAY_URL}"
  }
}
