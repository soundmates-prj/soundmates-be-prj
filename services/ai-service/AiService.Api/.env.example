# =============================================================================
# AiService — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# .env is gitignored; this file is safe to commit.
# =============================================================================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=ai_db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# JWT — must match auth-service JWT config
JWT_KEY=<SAME_SECRET_AS_AUTH_SERVICE>
JWT_ISSUER=Soundmates.Auth
JWT_AUDIENCE=Soundmates.Users

# LLM (scaffold)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=<API_KEY>
LLM_MODEL=gpt-4.1-mini

# TTS (VieNeuTTS scaffold)
TTS_PROVIDER=vieneutts
TTS_BASE_URL=http://vienetts:8080
TTS_API_KEY=

# Local audio storage (inside container path; use docker volume)
AUDIO_STORAGE_ROOT=/app/data/audios

# Used to generate absolute URLs (optional)
PUBLIC_BASE_URL=http://localhost:8067

