# =============================================================================
# LiveSessionService — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# .env is gitignored; this file is safe to commit.
# =============================================================================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=live_session_db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# AzuraCast (Admin ? API Keys ? create key with "Manage Stations" + "Manage Station Media")
AZURACAST_BASE_URL=http://azuracast:8080
AZURACAST_API_KEY=<KEY_ID>:<KEY_SECRET>

# JWT — copy the same Jwt:Key value used in auth-service
JWT_KEY=<SAME_SECRET_AS_AUTH_SERVICE>
JWT_ISSUER=Soundmates.Auth
JWT_AUDIENCE=Soundmates.Users

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUALHOST=/


